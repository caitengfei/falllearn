# 依赖（体积大、可重建）
node_modules/

# Python
__pycache__/
*.pyc

# 运行时数据 —— 首次启动由后端自动重建（init_db + 题库种子 + 演示账号）
*.db
*.db-shm
*.db-wal
backend/uploads/
# JWT 签名密钥（自动生成，禁止入库）
backend/jwt_secret

# DSH 内部调试残留（与平台无关，禁止入库）
tools/dsh_probe*
tools/ws_frames.json
tools/*_out.txt
tools/shots/
tools/**/_tmp*

# 杂项
*.log
.DS_Store
Thumbs.db

# 项目记忆（含账号密码/部署方法，严禁入库与上服务器）
PROJECT_MEMORY.md

# 大赛材料/知识产权材料包（含专利交底书、软著材料、隐私信息，严禁入库与上服务器）
materials/